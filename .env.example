# ── App ──────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Random 32+ char string. Generate with:  openssl rand -base64 48
AUTH_SECRET=replace-me-with-32-or-more-random-characters

# ── Database ─────────────────────────────────────────────────────────────
POSTGRES_DB=muusic
POSTGRES_USER=muusic
POSTGRES_PASSWORD=devpass
DATABASE_URL=postgres://muusic:devpass@localhost:5432/muusic

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=muusic <noreply@yourdomain.com>

# ── Mapbox ───────────────────────────────────────────────────────────────
# Server-side reverse geocoding (POST /api/me/location).
# Public token works server-side; if you have a secret token (sk.*), use it here.
MAPBOX_TOKEN=pk.eyJ1xxxxxxx
# Client-side rendering (Globe + AuthSuccessMap). Must be a PUBLIC token (pk.*).
# Can be the same value as MAPBOX_TOKEN if MAPBOX_TOKEN is also public.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1xxxxxxx

# ── Realtime ─────────────────────────────────────────────────────────────
# Public Socket.IO endpoint URL (browser-side). Same origin as APP_URL when
# nginx routes /socket.io/ to the realtime container.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# ── Cookie scope (cross-subdomain auth: admin.muusic.live) ───────────────
# Leave blank in dev (host-only). In prod, set to ".muusic.live" so the
# session cookie set by muusic.live is also sent on admin.muusic.live.
COOKIE_DOMAIN=

# ── Existing ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
