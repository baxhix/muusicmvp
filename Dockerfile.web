# ─── deps ──────────────────────────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# ─── builder ───────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# NEXT_PUBLIC_* vars are inlined into the client bundle at build time.
# Pass them as build args so the runtime container ships with the right values.
ARG NEXT_PUBLIC_MAPBOX_TOKEN
ENV NEXT_PUBLIC_MAPBOX_TOKEN=$NEXT_PUBLIC_MAPBOX_TOKEN

# next.config.ts has `output: 'standalone'` → produces a slim runtime tree.
RUN npm run build

# ─── runner ────────────────────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Run as non-root.
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001

COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Schema migrations folder + standalone migrate.mjs runner. We don't ship
# drizzle-kit (dev-only) — instead a small node script uses drizzle-orm
# (which IS in prod deps) to apply migrations on container start. See
# scripts/migrate.mjs and scripts/entrypoint.sh for context.
COPY --from=builder --chown=nextjs:nodejs /app/drizzle ./drizzle
COPY --from=builder --chown=nextjs:nodejs /app/scripts/migrate.mjs ./scripts/migrate.mjs
COPY --from=builder --chown=nextjs:nodejs /app/scripts/entrypoint.sh ./scripts/entrypoint.sh
RUN chmod +x /app/scripts/entrypoint.sh

# Install drizzle-orm + pg as standalone packages so the boot-time
# migrate.mjs can resolve them at /app/node_modules. Next.js's
# standalone tracer bundles both packages INSIDE server.js (webpack
# inlines them — they're not separately at node_modules/), which is
# correct for the server runtime but leaves boot scripts that
# `import` them from outside the bundle stranded. This adds ~30MB
# of duplicated code for a much-better-than-manual-migrate UX.
#
# Done in a scratch dir then merged into /app/node_modules so we
# don't touch the standalone's own /app/package.json (the Next.js
# server bundle reads "type": "module" from it).
RUN mkdir -p /app/node_modules /tmp/migrate-deps && \
    cd /tmp/migrate-deps && \
    npm init -y >/dev/null 2>&1 && \
    npm install --no-audit --no-fund drizzle-orm pg && \
    cp -r /tmp/migrate-deps/node_modules/. /app/node_modules/ && \
    rm -rf /tmp/migrate-deps && \
    chown -R nextjs:nodejs /app/node_modules

# Avatar + report-evidence + group-image upload destinations — Compose
# mounts a named volume here so files survive container rebuilds.
# Created with the right ownership so the unprivileged nextjs user can
# write to them.
RUN mkdir -p /app/uploads/avatars /app/uploads/reports /app/uploads/groups && \
    chown -R nextjs:nodejs /app/uploads

USER nextjs

EXPOSE 3000
CMD ["/app/scripts/entrypoint.sh"]
