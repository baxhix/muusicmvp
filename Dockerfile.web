# ─── deps ──────────────────────────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# ─── builder ───────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# NEXT_PUBLIC_* vars are inlined into the client bundle at build time.
# Pass them as build args so the runtime container ships with the right values.
ARG NEXT_PUBLIC_MAPBOX_TOKEN
ENV NEXT_PUBLIC_MAPBOX_TOKEN=$NEXT_PUBLIC_MAPBOX_TOKEN

# next.config.ts has `output: 'standalone'` → produces a slim runtime tree.
RUN npm run build

# ─── runner ────────────────────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Run as non-root.
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001

COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Schema migrations folder + standalone migrate.mjs runner. We don't ship
# drizzle-kit (dev-only) — instead a small node script uses drizzle-orm
# (which IS in prod deps) to apply migrations on container start. See
# scripts/migrate.mjs and scripts/entrypoint.sh for context.
COPY --from=builder --chown=nextjs:nodejs /app/drizzle ./drizzle
COPY --from=builder --chown=nextjs:nodejs /app/scripts/migrate.mjs ./scripts/migrate.mjs
COPY --from=builder --chown=nextjs:nodejs /app/scripts/entrypoint.sh ./scripts/entrypoint.sh
RUN chmod +x /app/scripts/entrypoint.sh

# Avatar + report-evidence upload destinations — Compose mounts a named
# volume here so files survive container rebuilds. Created with the right
# ownership so the unprivileged nextjs user can write to them.
RUN mkdir -p /app/uploads/avatars /app/uploads/reports && \
    chown -R nextjs:nodejs /app/uploads

USER nextjs

EXPOSE 3000
CMD ["/app/scripts/entrypoint.sh"]
